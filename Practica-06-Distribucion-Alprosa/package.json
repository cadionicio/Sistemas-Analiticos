{
  "name": "alprosa-distribucion",
  "version": "0.9.0",
  "private": true,
  "description": "Sistema de Distribución Multimodal — caso Alprosa (datos sintéticos NutriDemo)",
  "author": "Dionicio Achachagua, Cesar Alonso",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build:html": "vite build",
    "test": "vitest run",
    "build:exe": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "docx": "^9.15.3",
    "exceljs": "^4.4.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "pe.uni.ge803u.alprosa.distribucion",
    "productName": "Sistema de Distribucion Alprosa",
    "copyright": "Prototipo académico — datos sintéticos NutriDemo",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "electron/**",
      "dist-html/index.html",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "12_Sistema_Distribucion_Alprosa.exe"
    },
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "publish": null
  }
}